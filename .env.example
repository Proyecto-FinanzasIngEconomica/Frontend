# La URL no debe incluir /api/v1. En desarrollo, /api pasa por el proxy de Vite.
VITE_API_BASE_URL=
# No activar hasta implementar y acordar el contrato de autenticación.
VITE_IDENTITY_PROVIDER=local
VITE_AUTH_ENABLED=false
VITE_AUTH_LOGIN_PATH=/api/v1/auth/login
API_PROXY_TARGET=http://localhost:8080
